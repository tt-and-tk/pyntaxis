; 行末コメントの;以降が，;の直前の空白の有無に関わらずコメントとして無視されることを確認する
; .global行・関数ラベル・局所ラベル・命令行のいずれでも，コメント中の , ; : は解釈されない
; タブは非対応だが，コメント中のタブはエラーにならない

.global main, func;関数一覧 ; main,func

main:;エントリ: 開始
    call func;funcを呼ぶ
    add r34 r32 r33;足し算;二重のコメント記号
    eq r34 r33 .L0;.L0: へ分岐
.L0:;分岐先
    ret;mainのretは自分自身へのjmpになる

func:;関数
    mov 15 r33 r0 4;代入
    ret;main以外のretはretのまま残る	行末コメント中のタブは許容する
