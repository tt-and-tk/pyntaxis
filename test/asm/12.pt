; M系・IO系命令の動作確認

.global main

main:
    scan r1
    print r1 0
    rm fh r1 r2
    wm fh r1 r2
    rmr fh r16 r2 0      ; SP相対・オフセット0
    rmr fh r1 r2 -4      ; 負のオフセット(10進)
    wmr fh r16 r2 8      ; SP相対・正のオフセット
    wmr fh r1 r2 10h     ; 16進のオフセット
    brm fh r1 r2 r3
    bwm fh r1 r2 r3
    ret
