; 関数の番地を即値としてレジスタへ載せ，レジスタで呼び出し先を指定したcallで呼び出せることを確認する
; 即値の位置に書いた関数名は，その関数の先頭indexに即値使用フラグ付きで解決される
; 'r'で始まる関数名でも，続く部分が数値表記でなければレジスタではなく関数名として扱われる

.global main, func1, rx

main:
    mov fh r0 r1 func1   ; r1 = func1の先頭index
    call r1              ; r1の値を呼び出し先とする(rs1=1，即値使用フラグなし)
    mov fh r0 r2 rx      ; r2 = rxの先頭index
    call r2h             ; レジスタ番号は基数付きでも書ける
    wm fh r0 r1 rx       ; 即値の位置であれば命令を問わず関数名が解決される
    rmr fh r16 r3 func1  ; 即値が必須の命令でも即値使用フラグが立つ
    call rx              ; 関数名の呼び出し先は従来どおり即値で渡す
    ret

func1:
    ret

rx:
    ret
