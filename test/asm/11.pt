; S系・F系・J系命令の動作確認（前方/後方ジャンプ含む）

.global main

main:
.L1:                ; index 0: 後方ジャンプの飛び先
    sll r1 r2 r3
    srl r1 r2 r3
    sla r1 r2 r3
    sra r1 r2 r3
    eq r1 r2 .L0    ; 前方 → .L0(16) - 4 = 12
    ne r1 r2 .L0    ; 前方 → 16 - 5 = 11
    lt r1 r2 .L0    ; 前方 → 16 - 6 = 10
    gt r1 r2 .L0    ; 前方 → 16 - 7 = 9
    elt r1 r2 .L0   ; 前方 → 16 - 8 = 8
    egt r1 r2 .L1   ; 後方 → .L1(0) - 9 = -9（負オフセット）
    ltu r1 r2 .L0   ; 前方 → 16 - 10 = 6
    gtu r1 r2 .L0   ; 前方 → 16 - 11 = 5
    eltu r1 r2 .L0  ; 前方 → 16 - 12 = 4
    egtu r1 r2 .L1  ; 後方 → .L1(0) - 13 = -13（負オフセット）
    jmp .L0         ; 絶対 → 16
    jmp .L1         ; 絶対 → 0
.L0:
    ret
